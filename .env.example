# ============================================================
# Supabase 設定
# ============================================================
# Supabase プロジェクトの API URL（ダッシュボード > Settings > API で確認）
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-url>

# Supabase 匿名キー（クライアント側で使用、公開可）
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Supabase サービスロールキー（サーバー側のみで使用、絶対に公開しないこと）
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Supabase JWT シークレット（Server-Side Auth 検証用）
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# ============================================================
# データベース接続
# ============================================================
# PgBouncer 経由の接続（通常のクエリ用）
DATABASE_URL=<your-supabase-db-url>

# 直接接続（マイグレーション実行用）
DIRECT_URL=<your-supabase-direct-db-url>

# ============================================================
# Anthropic Claude API
# ============================================================
# Claude API キー（https://console.anthropic.com で取得）
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# 使用するモデル（デフォルト: claude-haiku-4-5）
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================
# Next.js 設定
# ============================================================
# 本番環境の URL（CORS・Cookie 設定に使用）
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ============================================================
# Supabase Storage 設定
# ============================================================
# ファイルアップロード用バケット名
NEXT_PUBLIC_STORAGE_BUCKET=project-files

# ============================================================
# レート制限・タイムアウト設定
# ============================================================
# Claude API ストリーミングのタイムアウト（秒）
AI_STREAM_TIMEOUT_SECONDS=55

# 1ユーザーあたりの AI リクエスト上限（1時間あたり）
AI_RATE_LIMIT_PER_HOUR=20

# ============================================================
# Playwright E2E テスト設定（.env.test.local に設定すること）
# ============================================================
# テスト用ベースURL
TEST_BASE_URL=http://localhost:3000

# テスト用ユーザー認証情報（Supabase で事前に作成しておく）
TEST_EMAIL=<your-test-user-email>
TEST_PASSWORD=<your-test-user-password>
